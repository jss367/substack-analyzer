{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Run: Substack Analyzer (headless)",
            "type": "debugpy",
            "request": "launch",
            "program": "/Users/julius/git/substack-analyzer/scripts/run_headless.py",
            "console": "integratedTerminal",
            "cwd": "/Users/julius/git/substack-analyzer",
            "justMyCode": true,
            "args": [
                "--all",
                "data/cityofyes_emails_2025-09-11.csv",
                "--all-has-header",
                "--all-date-col",
                "0",
                "--all-count-col",
                "1",
                "--paid",
                "data/cityofyes_subscribers_2025-09-11.csv",
                "--paid-has-header",
                "--paid-date-col",
                "0",
                "--paid-count-col",
                "1",
                // "--events",
                // "/Users/julius/path/to/events.csv",
                "--adspend",
                "/Users/julius/git/substack-analyzer/data/ad_spend_once.csv",
                "--max-changes",
                "4",
                "--lam",
                "0.5",
                "--theta",
                "500",
                "--out-dir",
                "/Users/julius/git/substack-analyzer/outputs"
            ]
        },
        {
            "name": "Streamlit: E2E Walkthrough",
            "type": "debugpy",
            "request": "launch",
            "module": "streamlit",
            "args": [
                "run",
                "scripts/e2e_walkthrough.py",
                "--server.headless=false",
                "--browser.gatherUsageStats=false"
            ],
            "cwd": "${workspaceFolder}",
            "env": {
                "PYTHONPATH": "${workspaceFolder}"
            },
            "console": "integratedTerminal",
            "justMyCode": false,
            "subProcess": true
        }
    ]
}
